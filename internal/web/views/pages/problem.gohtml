{{ define "heading" }}

<div class="content">
  <h2>{{ .Page.Problem.Name | salmond }}</h2>
  <p class="subtitle">Par {{ .Page.Problem.Author }}</p>
  <p class="subtitle">Difficulté : {{ .Page.Difficulty.Name }}</p>
  <div class="btns">
    <a href="./input/" class="btn">{{ if .Page.FreePlay }}Input{{ else }}Votre input{{ end }}</a>
  </div>
</div>
{{ end }}
{{ define "content" }}
<main>
  {{ range $part := .Page.Content }}
  {{ $part }}
  {{ end }}

  {{ if and (not .Page.FreePlay) (eq .Page.SolvedParts .Page.Problem.Parts) }}
  <p>Vous avez déjà résolu ce problème.</p>
  {{ else }}
  <br />
  <p>Vous pouvez récupérer votre input en cliquant <a href="./input/">ici</a>.</p>

  <div class="response-target"></div>
  <p>Votre réponse :</p>
  <form hx-post="./submit/{{ if .Page.FreePlay }}{{ .Page.CurrentPart }}{{ else }}{{ len .Page.Content }}{{ end }}" hx-target=".response-target" hx-swap="innerHTML">
    <input type="text" placeholder="123..." name="response" />
    <button type="submit" class="btn">Vérifier</button>
  </form>
  {{ end }}
</main>
{{ end }}
