{{ define "content" }}
<main class="larger admin-table-page">
	<h1>Utilisateurs</h1>
	<div class="btns">
		<a class="btn btn--large" href="/admin/users/new">Nouvel utilisateur</a>
	</div>
	<form id="admin-generation-form" method="post" action="/admin/generations" class="admin-generation-form">
		<div>
			<label for="generation-contest">Concours</label>
			<select id="generation-contest" name="contest" required>
				<option value="">Sélectionner un concours</option>
				{{ range .Page.Contests }}<option value="{{ .Slug }}">{{ .Name }}</option>{{ end }}
			</select>
		</div>
		<div>
			<label for="generation-mode">Mode</label>
			<select id="generation-mode" name="mode">
				<option value="replace">Remplacer</option>
				<option value="missing">Compléter uniquement</option>
			</select>
		</div>
		<button class="btn" type="submit">Générer les données sélectionnées</button>
	</form>
	<form method="post" action="/admin/users/import" enctype="multipart/form-data" class="admin-user-import">
		<div>
			<label for="users">Importer des utilisateurs depuis un fichier CSV</label>
			<input id="users" name="users" type="file" accept=".csv,text/csv" required>
		</div>
		<button class="btn" type="submit">Importer</button>
	</form>
	{{ if .Page.Error }}
	<div class="response response--danger">
		<p>{{ .Page.Error }}</p>
	</div>
	{{ end }}
	<div class="admin-table-wrapper">
		<table class="admin-table admin-table--users">
			<thead><tr><th scope="col">Choix</th><th scope="col">Utilisateur</th><th scope="col">Statut</th><th scope="col">Données</th><th scope="col">Activation</th><th scope="col">Modifier</th><th scope="col">Admin</th><th scope="col">Supprimer</th></tr></thead>
			<tbody>
			{{ range .Page.Users }}
			<tr>
				<td><input id="generation-user-{{ .ID }}" form="admin-generation-form" name="user" value="{{ .ID }}" type="checkbox" aria-label="Sélectionner {{ .Username }}"></td>
				<td><label for="generation-user-{{ .ID }}"><strong>{{ .Username }}</strong></label><small>{{ .Email }}</small></td>
				<td>{{ if .Activated }}Activé{{ else }}Non activé{{ end }}{{ if .Admin }}<small>Administrateur</small>{{ end }}</td>
				<td><a href="/admin/users/{{ .ID }}/problems">{{ .CompleteProblems }} {{ if eq .CompleteProblems 1 }}problème{{ else }}problèmes{{ end }}</a></td>
				<td>
					{{ if not .Activated }}{{ if .ActivationLink }}
					<a class="btn admin-table__button" href="{{ .ActivationLink }}">{{ if $.Config.RegistrationRequiresApproval }}Valider{{ else }}Activer{{ end }}</a>
					{{ else }}<form method="post" action="/admin/users/{{ .ID }}/approve"><button class="btn admin-table__button" type="submit">Valider</button></form>{{ end }}{{ else }}—{{ end }}
				</td>
				<td><a class="btn admin-table__button" href="/admin/users/{{ .ID }}/edit">Modifier</a></td>
				<td>{{ if not .Admin }}<a class="btn admin-table__button" href="/admin/users/{{ .ID }}/admin">Promouvoir</a>{{ else }}—{{ end }}</td>
				<td><a class="btn btn--danger admin-table__button" href="/admin/users/{{ .ID }}/delete">Supprimer</a></td>
			</tr>
			{{ else }}<tr><td colspan="8">Aucun utilisateur n'a été créé.</td></tr>{{ end }}
			</tbody>
		</table>
	</div>
</main>
{{ end }}
