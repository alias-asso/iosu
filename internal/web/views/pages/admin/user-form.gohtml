{{ define "content" }}
<main>
	<h1>{{ .Page.Title }}</h1>
	{{ if .Page.Error }}
	<div class="response response--danger">
		<p>{{ .Page.Error }}</p>
	</div>
	{{ end }}
	<form method="post" action="{{ .Page.Action }}" class="larger">
		<div>
			<label for="username">Nom d'utilisateur</label>
			<input id="username" name="username" value="{{ .Page.Username }}" maxlength="32" required>
		</div>
		<div>
			<label for="email">Adresse e-mail</label>
			<input id="email" name="email" type="email" value="{{ .Page.Email }}" maxlength="254" required>
		</div>
		<button class="btn" type="submit">{{ .Page.Submit }}</button>
	</form>
</main>
{{ end }}
