{{ define "content" }}
<main>
	<h1>{{ .Page.Title | salmond }}</h1>
	{{ if .Page.Error }}
	<div class="response response--danger">
		<p>{{ .Page.Error }}</p>
	</div>
	{{ end }}
	<form method="post" action="{{ .Page.Action }}" class="larger">
		<div>
			<label for="slug">Identifiant</label>
			<input id="slug" name="slug" value="{{ .Page.Slug }}" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" maxlength="70" required>
		</div>
		<div>
			<label for="name">Nom</label>
			<input id="name" name="name" value="{{ .Page.Name }}" maxlength="70" required>
		</div>
		<div>
			<label for="description">Description</label>
			<textarea id="description" name="description">{{ .Page.Description }}</textarea>
		</div>
		<div>
			<label for="mode">Mode</label>
			<select id="mode" name="mode">
				<option value="normal"{{ if eq .Page.Mode "normal" }} selected{{ end }}>Concours</option>
				<option value="free_play"{{ if eq .Page.Mode "free_play" }} selected{{ end }}>Jeu libre</option>
			</select>
		</div>
		<label class="form--checkbox" for="infinite">
			<input id="infinite" name="infinite" type="checkbox"{{ if .Page.Infinite }} checked{{ end }}>
			Durée illimitée
		</label>
		<div id="contest-dates" class="form--reverse">
			<div>
				<label for="start-at">Début</label>
				<input id="start-at" name="start-at" type="datetime-local" value="{{ .Page.StartAt }}" required>
			</div>
			<div>
				<label for="end-at">Fin</label>
				<input id="end-at" name="end-at" type="datetime-local" value="{{ .Page.EndAt }}" required>
			</div>
		</div>
		<label class="form--checkbox" for="unlisted">
			<input id="unlisted" name="unlisted" type="checkbox"{{ if .Page.Unlisted }} checked{{ end }}>
			Ne pas afficher ce concours dans les archives
		</label>
		<label id="auto-generate-field" class="form--checkbox" for="auto-generate">
			<input id="auto-generate" name="auto-generate" type="checkbox"{{ if .Page.AutoGenerate }} checked{{ end }}>
			Générer automatiquement les données des nouveaux comptes
		</label>
		<button class="btn" type="submit">{{ .Page.Submit }}</button>
	</form>
	<script src="/static/js/admin-contest-form.js"></script>
</main>
{{ end }}
