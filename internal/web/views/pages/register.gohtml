{{ define "heading" }}
{{ end }}
{{ define "content" }}
<main class="flex">
	<div>
		<h3>Créer un compte</h3>
		{{ if .Page.Success }}
		<div class="response response--success">
			<p>{{ .Page.Success }}</p>
		</div>
		{{ else }}
		<form method="post" action="/register" class="larger">
			<div>
				<label for="username">Nom d'utilisateur</label>
				<input id="username" name="username" value="{{ .Page.Username }}" maxlength="32" required>
			</div>
			<div>
				<label for="email">Adresse e-mail</label>
				<input id="email" name="email" type="email" value="{{ .Page.Email }}" maxlength="254" required>
			</div>
			<div>
				<label for="password">Mot de passe</label>
				<input id="password" name="password" type="password" required>
				<sub>Le mot de passe doit faire 8 caractères ou plus, contenir des majuscules et des minuscules, au moins un chiffre et un caractère spécial.</sub>
			</div>
			<div>
				<label for="password-confirmation">Confirmer le mot de passe</label>
				<input id="password-confirmation" name="password-confirmation" type="password" required>
				{{ if .Page.Error }}<sub class="danger">{{ .Page.Error }}</sub>{{ end }}
			</div>
			<div class="btns btns--no-marge">
				<button class="btn" type="submit">S'inscrire</button>
			</div>
		</form>
		{{ end }}
	</div>
</main>
{{ end }}
